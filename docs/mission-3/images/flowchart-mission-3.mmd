flowchart LR
    subgraph S1[ช่วงที่ 1 เริ่มด่าน]
        direction TB
        A[เข้าด่าน 3] --> B{เล่นครั้งแรก}
        B -- ใช่ --> T[Tutorial ป้าส้ม<br/>ดูโดมสาธิต แล้วทำตาม]
        B -- ไม่ใช่ --> P
        T --> P[เตรียมตัวก่อนเข้ากะ<br/>ดูคลิป / อ่านแชตโดม / ลากวาง]
    end
    subgraph S2[ช่วงที่ 2 ลูกค้าหนึ่งคน]
        direction TB
        G1[เรียกคิว ลูกค้ามาถึง] --> G2[การ์ดคำขอเด้งขึ้น<br/>อ่านโดเมนที่ขอ]
        G2 --> G3[ติดป้ายประเภท<br/>gTLD / ccTLD ไทย / หมวดสงวน<br/>และใช้กับใคร]
        G3 --> G4[สัมภาษณ์ลูกค้า<br/>ถามได้ไม่เกิน 3 ข้อ]
        G4 --> G5[เลือกตรา 1 ใน 4<br/>เสนอนามสกุล ติดป้าย ให้เหตุผล]
        HB[หันซ้าย เปิดคู่มือ<br/>จำกัดเวลา] -.-> G3
        DM[หันขวา ถามโดม<br/>จำกัดคำใบ้] -.-> G5
        G5 --> J{ตัดสินถูก}
        J -- ถูก --> OK[ลูกค้ายิ้ม 2 แต้ม]
        J -- ผิด --> NG[ลูกค้างง โดมถามนำ<br/>แก้ได้ 1 รอบ]
        NG -- แก้ถูก --> H1[1 แต้ม]
        NG -- ผิดอีก --> H0[0 แต้ม โดมอธิบาย]
        OK --> N{ครบคิว}
        H1 --> N
        H0 --> N
        N -- ยัง --> L[ลูกค้าคนถัดไป<br/>กลับไปเรียกคิว]
    end
    subgraph S3[ช่วงที่ 3 จบกะ]
        direction TB
        S[ลูกค้าคนสุดท้าย<br/>ธุรกิจของฉัน] --> R[รายงานจบกะ<br/>ดาว แต้มตรา แต้มจำแนกรายกลุ่ม]
        R --> Q{ตราผ่านเกณฑ์<br/>และจำแนกถูก 80%}
        Q -- ผ่าน --> W[ได้บัตรนามสกุลของฉัน<br/>ไปด่าน 4]
        Q -- ไม่ผ่าน --> X[สายพานคัดแยก<br/>เฉพาะกลุ่มที่พลาด]
        X --> Y[ลูกค้าใหม่ 1-2 คน] --> R
    end
    S1 --> S2
    S2 -- ครบคิว --> S3

# ตัวอย่าง environment variables — คัดลอกเป็น .env.local แล้วเติมค่าจริง
#
#   cp .env.example .env.local
#
# ⚠️ ไฟล์นี้ถูก commit ขึ้น git ห้ามใส่ค่าจริงลงไปเด็ดขาด ค่าทุกตัวในนี้เป็นค่าว่างหรือของปลอม
# ⚠️ ห้ามตั้งชื่อ env ที่ขึ้นต้นด้วย NEXT_PUBLIC_ ให้ service role key หรือ key ของ AI
#    เพราะ Next.js จะฝังค่านั้นลงไฟล์ JavaScript ฝั่งเบราว์เซอร์ ใครเปิด DevTools ก็อ่านได้ทั้งหมด
#    ตรวจซ้ำได้ด้วย: npx tsx scripts/check-deploy.ts

# ─────────────────────────────────────────────────────────────
# ฝั่งเซิร์ฟเวอร์เท่านั้น — ห้ามส่งไปเบราว์เซอร์ ห้ามขึ้นต้น NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────────

# service role key ของ Supabase — bypass RLS ทุกตาราง ใช้ได้เฉพาะใน API route / สคริปต์ฝั่งเซิร์ฟเวอร์
# local: ได้จาก `npx supabase status` (บรรทัด SERVICE_ROLE_KEY)
# cloud: Supabase Dashboard > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# ลายเซ็น session cookie ของนักเรียนและครู (jose HS256) ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างใหม่: node -e "console.log(require('node:crypto').randomBytes(36).toString('base64url'))"
# เปลี่ยนค่านี้ = ทุกคนที่ล็อกอินอยู่หลุดทันที ห้ามเปลี่ยนกลางคาบเรียน
SESSION_SECRET=

# key ของผู้ช่วย AI — ทีมมีคีย์จริงแล้ว (อยู่ใน .env.local ของแต่ละเครื่อง ห้ามคัดลอกมาไว้ในไฟล์นี้)
# ไม่ใส่ก็ยังเล่นจบได้ ระบบจะตกไปใช้ตัวสำรองแบบกฎ (lib/ai/fallback.ts) แล้วติดป้าย source: 'fallback'
# ห้าม cat/echo/grep ค่าคีย์ออกมาที่ไหนก็ตาม ตรวจว่ามีคีย์ด้วย npx tsx scripts/check-deploy.ts
# Typhoon: https://opentyphoon.ai (ภาษาไทยเป็นธรรมชาติกว่า)
TYPHOON_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# กุญแจให้ worker ตรวจงานเบื้องหลังยิง POST /api/jobs/drain จากเครื่องอื่นได้ (header x-worker-secret)
# ไม่ใส่ก็ยังใช้ได้ผ่านคุกกี้ครูที่ล็อกอินอยู่ แต่ scripts/grade-worker.ts จะรันไม่ได้
# สร้างใหม่: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# บนคลาวด์ต้องสร้างค่าใหม่ ห้ามใช้ค่าเดียวกับเครื่องพัฒนา
GRADE_WORKER_SECRET=

# ─────────────────────────────────────────────────────────────
# เปิดเผยได้ (ไม่ลับ) แต่โค้ดปัจจุบันอ่านฝั่งเซิร์ฟเวอร์ทั้งคู่ จึงยังไม่ต้องมี NEXT_PUBLIC_
# ─────────────────────────────────────────────────────────────

# URL ของ Supabase
# local: http://127.0.0.1:54321
# cloud: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# anon key — ปลอดภัยที่จะเปิดเผย เพราะ RLS กันไว้แล้ว และโปรเจกต์นี้ revoke สิทธิ์ anon ออกจากทุกตาราง
# ใช้แค่ตอนตรวจรหัสผ่านครูผ่าน Supabase Auth เท่านั้น
# local: `npx supabase status` (บรรทัด ANON_KEY) · cloud: Dashboard > Project Settings > API > anon public
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# ตัวเลือก
# ─────────────────────────────────────────────────────────────

# แถบเดโมที่ให้สลับระดับตัวช่วยเองในสถานี B — ตอนสอนจริง/ตอนส่งลิงก์ให้ตั้งเป็น 0
DEMO_MODE=1

# ใช้เฉพาะสคริปต์ที่ต่อ psql ตรง ๆ แอปไม่ได้อ่านค่านี้
# local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# cloud: Dashboard > Project Settings > Database > Connection string (ใส่รหัสผ่านเอง)
SUPABASE_DB_URL=

# ใช้ครั้งเดียวตอนรัน scripts/seed-production.ts เพื่อสร้างบัญชีครูจริง
# ตั้งค่าตอนรัน แล้วลบออกจาก .env.local ทันทีหลังรันเสร็จ อย่าเก็บรหัสผ่านครูไว้ในไฟล์
SEED_TEACHER_EMAIL=teacher@example.ac.th
SEED_TEACHER_PASSWORD=
SEED_TEACHER_NAME=ครูผู้สอน
# รหัสห้อง 6 ตัว ใช้ตัวอักษร 23456789ABCDEFGHJKMNPQRSTUVWXYZ เท่านั้น (ไม่มี 0 O 1 I L)
SEED_ROOM_CODE=

# ─────────────────────────────────────────────────────────────
# ประตูเปิดตัว (launch gate) — ดู docs/deploy.md ข้อ 4.4
# ─────────────────────────────────────────────────────────────

# true = เปิดให้เล่นปกติ · ไม่ตั้ง/อย่างอื่น: production ปิด (ทุกหน้าไป /landing, API ตอบ 503) · dev เปิด
APP_OPEN=
# คีย์ลับสำหรับ /preview?key=... ให้เจ้าของ/ผู้ทดสอบใช้แอปเต็มตอนยังปิด (ฝั่งเซิร์ฟเวอร์เท่านั้น)
PREVIEW_KEY=
# วันเวลาเปิดให้เล่น รูปแบบ ISO เช่น 2026-11-03T08:00:00+07:00 (ไม่ลับ ถูกฝังตอน build — เปลี่ยนแล้วต้อง redeploy)
NEXT_PUBLIC_OPEN_AT=
